
import os
import numpy as np
import pandas as pd
import joblib

from sklearn.ensemble import IsolationForest

# Files
history_file = "historical_process_records.csv"
model_file = "process_anomaly_model.pkl"

features = [
    "process_size_mb",
    "memory_usage_mb",
    "cpu_usage",
    "execution_time_sec",
    "thread_count",
    "network_connections",
    "bytes_sent_mb",
    "failed_accesses",
    "file_operations"
]

# Generate historical records
def generate_history(count=800):
    rng = np.random.default_rng()

    data = pd.DataFrame({
        "process_size_mb": rng.lognormal(2.0, 0.65, count),
        "memory_usage_mb": rng.lognormal(3.0, 0.55, count),
        "cpu_usage": rng.beta(2, 8, count) * 100,
        "execution_time_sec": rng.lognormal(2.0, 0.65, count),
        "thread_count": rng.integers(1, 35, count),
        "network_connections": rng.poisson(3, count),
        "bytes_sent_mb": rng.lognormal(-0.5, 1.0, count),
        "failed_accesses": rng.poisson(0.3, count),
        "file_operations": rng.poisson(20, count)
    })

    data["process_size_mb"] = data["process_size_mb"].clip(0.5, 250)
    data["memory_usage_mb"] = data["memory_usage_mb"].clip(2, 1500)
    data["cpu_usage"] = data["cpu_usage"].clip(0, 100)
    data["execution_time_sec"] = data["execution_time_sec"].clip(0.1, 600)
    data["thread_count"] = data["thread_count"].clip(1, 100)
    data["network_connections"] = data["network_connections"].clip(0, 100)
    data["bytes_sent_mb"] = data["bytes_sent_mb"].clip(0, 500)
    data["failed_accesses"] = data["failed_accesses"].clip(0, 20)
    data["file_operations"] = data["file_operations"].clip(0, 1000)

    return data


# Prepare features
def prepare_features(data):
    result = data[features].copy()

    result["memory_size_ratio"] = (
        result["memory_usage_mb"] /
        result["process_size_mb"].clip(lower=0.1)
    )

    result["time_size_ratio"] = (
        result["execution_time_sec"] /
        result["process_size_mb"].clip(lower=0.1)
    )

    result["network_per_thread"] = (
        result["network_connections"] /
        result["thread_count"].clip(lower=1)
    )

    result["data_per_connection"] = (
        result["bytes_sent_mb"] /
        result["network_connections"].clip(lower=1)
    )

    return result.replace([np.inf, -np.inf], 0).fillna(0)


# Load or create historical data
if os.path.exists(history_file):
    history = pd.read_csv(history_file)
    print("Loaded historical process records.")
else:
    history = generate_history()
    history.to_csv(history_file, index=False)
    print("Created historical process records.")

# Load or train model
if os.path.exists(model_file):
    model = joblib.load(model_file)
    print("Loaded previously trained model.")
else:
    X_history = prepare_features(history)

    model = IsolationForest(
        n_estimators=250,
        contamination=0.05,
        max_samples="auto",
        random_state=42
    )

    model.fit(X_history)
    joblib.dump(model, model_file)
    print("Model trained and saved.")

# Generate one new process
rng = np.random.default_rng()

if rng.random() < 0.80:
    new_process = pd.DataFrame([{
        "process_size_mb": round(rng.lognormal(2.0, 0.65), 2),
        "memory_usage_mb": round(rng.lognormal(3.0, 0.55), 2),
        "cpu_usage": round(rng.beta(2, 8) * 100, 2),
        "execution_time_sec": round(rng.lognormal(2.0, 0.65), 2),
        "thread_count": int(rng.integers(1, 35)),
        "network_connections": int(rng.poisson(3)),
        "bytes_sent_mb": round(rng.lognormal(-0.5, 1.0), 2),
        "failed_accesses": int(rng.poisson(0.3)),
        "file_operations": int(rng.poisson(20))
    }])
else:
    pattern = rng.choice(["memory", "cpu", "time", "network", "access"])

    new_process = pd.DataFrame([{
        "process_size_mb": round(rng.uniform(1, 10), 2),
        "memory_usage_mb": round(rng.uniform(20, 100), 2),
        "cpu_usage": round(rng.uniform(10, 40), 2),
        "execution_time_sec": round(rng.uniform(1, 30), 2),
        "thread_count": int(rng.integers(1, 15)),
        "network_connections": int(rng.integers(0, 10)),
        "bytes_sent_mb": round(rng.uniform(0, 10), 2),
        "failed_accesses": int(rng.integers(0, 3)),
        "file_operations": int(rng.integers(0, 50))
    }])

    if pattern == "memory":
        new_process.loc[0, "memory_usage_mb"] = round(rng.uniform(900, 1800), 2)
    elif pattern == "cpu":
        new_process.loc[0, "cpu_usage"] = round(rng.uniform(90, 100), 2)
    elif pattern == "time":
        new_process.loc[0, "execution_time_sec"] = round(rng.uniform(800, 2000), 2)
    elif pattern == "network":
        new_process.loc[0, "network_connections"] = int(rng.integers(100, 300))
        new_process.loc[0, "bytes_sent_mb"] = round(rng.uniform(500, 1500), 2)
    elif pattern == "access":
        new_process.loc[0, "failed_accesses"] = int(rng.integers(20, 100))
        new_process.loc[0, "file_operations"] = int(rng.integers(800, 1500))

# Calculate score
X_new = prepare_features(new_process)
anomaly_score = model.decision_function(X_new)[0]

# Display result
print("\nNew Process Details:")
print(new_process.to_string(index=False))
print("\nAnomaly Score:", round(float(anomaly_score), 4))

# Save result
new_process["anomaly_score"] = round(float(anomaly_score), 4)
new_process.to_csv("latest_process_score.csv", index=False)

print("\nScore saved to latest_process_score.csv")
