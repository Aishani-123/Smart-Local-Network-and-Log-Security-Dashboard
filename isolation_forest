import os
import time
import psutil
import numpy as np
import pandas as pd
import joblib
from sklearn.ensemble import IsolationForest

history_file = "real_historical_process_records.csv"
model_file = "real_process_anomaly_model.pkl"
result_file = "latest_process_score.csv"

base_features = [
    "process_size_mb",
    "memory_usage_mb",
    "cpu_usage",
    "execution_time_sec",
    "thread_count",
    "network_connections",
    "bytes_sent_mb",
    "failed_accesses",
    "file_operations"
]

def prepare_features(data):
    data = data.copy()
    data["memory_size_ratio"] = data["memory_usage_mb"] / data["process_size_mb"].clip(lower=0.1)
    data["time_size_ratio"] = data["execution_time_sec"] / data["process_size_mb"].clip(lower=0.1)
    data["network_per_thread"] = data["network_connections"] / data["thread_count"].clip(lower=1)
    data["data_per_connection"] = data["bytes_sent_mb"] / data["network_connections"].clip(lower=1)
    return data

def get_process_record(proc, cpu_interval=None):
    try:
        with proc.oneshot():
            pid = proc.pid
            memory = proc.memory_info().rss / (1024 * 1024)
            cpu = proc.cpu_percent(interval=cpu_interval)
            threads = proc.num_threads()
            age = max(0, time.time() - proc.create_time())

            try:
                exe = proc.exe()
                size = os.path.getsize(exe) / (1024 * 1024) if exe and os.path.isfile(exe) else 0.1
            except (psutil.AccessDenied, psutil.NoSuchProcess, OSError):
                size = 0.1

            try:
                connections = len(proc.net_connections(kind="inet"))
            except (psutil.AccessDenied, psutil.NoSuchProcess, OSError):
                connections = 0

        return {
            "pid": pid,
            "process_size_mb": max(size, 0.1),
            "memory_usage_mb": memory,
            "cpu_usage": cpu,
            "execution_time_sec": age,
            "thread_count": max(threads, 1),
            "network_connections": connections,
            "bytes_sent_mb": 0.0,
            "failed_accesses": 0,
            "file_operations": 0
        }

    except (psutil.NoSuchProcess, psutil.AccessDenied, psutil.ZombieProcess, OSError):
        return None

def collect_real_history():
    records = []

    print("Collecting real process data from your computer...")

    for sample in range(5):
        for proc in psutil.process_iter():
            record = get_process_record(proc)
            if record is not None:
                records.append(record)

        if sample < 4:
            time.sleep(2)

    if len(records) < 10:
        raise RuntimeError("Not enough process data was collected. Try again.")

    history = pd.DataFrame(records)
    history = history[base_features].replace([np.inf, -np.inf], np.nan)
    history = history.dropna()
    history = history[history["process_size_mb"] > 0]

    if len(history) < 10:
        raise RuntimeError("Not enough valid process records to train the model.")

    history.to_csv(history_file, index=False)
    print("Real process records saved:", len(history))
    return history

def get_history():
    if os.path.exists(history_file):
        try:
            history = pd.read_csv(history_file)
            if all(column in history.columns for column in base_features):
                history = history[base_features].replace([np.inf, -np.inf], np.nan).dropna()
                if len(history) >= 10:
                    print("Using saved real process history.")
                    return history
        except (OSError, ValueError, pd.errors.ParserError):
            pass

    return collect_real_history()

def load_or_train_model():
    if os.path.exists(model_file):
        try:
            model = joblib.load(model_file)
            if getattr(model, "n_features_in_", None) == len(base_features) + 4:
                print("Loaded saved anomaly detection model.")
                return model
        except (OSError, ValueError, EOFError, AttributeError):
            pass

    history = get_history()
    X_history = prepare_features(history[base_features])

    model = IsolationForest(
        n_estimators=250,
        contamination=0.05,
        max_samples="auto",
        random_state=42
    )

    model.fit(X_history)
    joblib.dump(model, model_file)
    print("Model trained on collected process records and saved.")
    return model

try:
    model = load_or_train_model()

    pid = int(input("Enter the process ID (PID) to analyse: "))

    try:
        proc = psutil.Process(pid)
        record = get_process_record(proc, cpu_interval=1)

        if record is None:
            raise RuntimeError("Could not access this process. It may have closed or access may be denied.")

        new_process = pd.DataFrame([record])
        X_new = prepare_features(new_process[base_features])

        score = float(model.decision_function(X_new)[0])

        print("\nAnomaly score:", round(score, 6))

        if score < 0:
            print("The process is unusual compared with the training data.")
        else:
            print("The process is not identified as unusual by the model.")

        new_process["anomaly_score"] = score
        new_process[["pid"] + base_features + ["anomaly_score"]].to_csv(result_file, index=False)
        print("Result saved to", result_file)

    except (psutil.NoSuchProcess, psutil.AccessDenied, ValueError, RuntimeError) as e:
        print("Could not analyse the process:", e)

except (RuntimeError, OSError, ValueError) as e:
    print("Error:", e)
